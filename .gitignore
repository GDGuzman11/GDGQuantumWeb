# dependencies
/node_modules
/.pnp
.pnp.js

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# misc
.DS_Store

# secrets / keys / certs — never commit these
*.pem
*.key
*.p12
*.pfx
*.pkcs12
id_rsa*
secrets.*
*.secret

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files — ignore EVERY .env variant except the committed template.
# (.env.example is the only env file that may be tracked, and it must contain
# placeholders only — never real secret values, since this repo is public.)
.env
.env.*
!.env.example

# typescript
*.tsbuildinfo

# vercel
.vercel

# prisma
/prisma/*.db

# claude code — per-machine local settings (permission grants etc.)
.claude/settings.local.json

# private, machine-local notes / guides — never commit (public repo)
/private/
