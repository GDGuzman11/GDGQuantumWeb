# ─────────────────────────────────────────────────────────────
# GDG Quantum — environment variable skeleton
# Copy to `.env` for development (Prisma CLI + Next both read it). NEVER commit real secrets.
# Nothing sensitive may be prefixed NEXT_PUBLIC_.
# ─────────────────────────────────────────────────────────────

# Database (PostgreSQL — Supabase/Neon/Vercel Postgres)
# Pooled connection string used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DB?pgbouncer=true&connection_limit=1"
# Direct (non-pooled) connection string used by Prisma Migrate.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/DB"

# Email (Resend preferred)
RESEND_API_KEY="re_7G8C8gno_F4JPvw6uT6YT31gckYTdsqv6"
CONTACT_FROM_EMAIL="GDG Quantum <hello@gdgquantum.com>"
CONTACT_OWNER_EMAIL="gabe@gdgquantum.com"

# SMTP fallback (only if Resend is not used)
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASSWORD=""

# Bot protection — Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY="0x4AAAAAADkRfY0u6fs8ZRC3"
TURNSTILE_SECRET_KEY="0x4AAAAAADkRfQruMhLPKhcWaJW9neotl3c"

# Rate limiting — Upstash Redis
UPSTASH_REDIS_REST_URL="https://whole-lark-148607.upstash.io"
UPSTASH_REDIS_REST_TOKEN="gQAAAAAAAkR_AAIgcDJkNTMxNTIxNzcxNjg0MTU4OWMwZTBmMmQzM2JmNjk3Yg"

# Salt for hashing IPs at rest
IP_HASH_SALT="2ae2d3de5e1b9ae15a4430c9e1b2b941c7d2654ca5de2a432497c1d0bd116b26"

# Public site origin — used for canonical URLs, sitemap, robots, OG/Twitter
# metadata (metadataBase). Set to the production domain in Phase 7 (no trailing
# slash), e.g. https://gdgquantum.com. Falls back to localhost in dev.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
