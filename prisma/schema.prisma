// GDG Quantum — Prisma schema (Phase 4).
// Managed PostgreSQL (Supabase / Neon / Vercel Postgres) with a POOLED runtime
// URL (DATABASE_URL) and a DIRECT URL (DIRECT_URL) used by Prisma Migrate.

generator client {
  provider = "prisma-client-js"
  // binaryTargets: "native" builds the engine for the local dev OS (Windows),
  // "rhel-openssl-3.0.x" builds the engine Vercel's serverless functions need
  // (Amazon Linux 2 / RHEL on OpenSSL 3.0). Without the rhel target the
  // generated client throws at runtime on Vercel ("Query engine library not
  // found"). Prisma 6.19.x ships both engines for these targets.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// One contact-form submission. Security fields (ipHash, userAgent) are
/// populated in Phase 5; they are nullable so Phase 4 can persist without them.
model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  ipHash    String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// A Starshell player account. Passwords are argon2id-hashed (never plaintext).
/// `sessionVersion` bumps on password reset / logout-all to invalidate old JWTs.
model User {
  id             String    @id @default(cuid())
  email          String    @unique // stored lowercased
  passwordHash   String
  displayName    String
  emailVerified  DateTime?
  sessionVersion Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  progress PlayerProgress?
  tokens   VerificationToken[]
}

/// Server-truth progression for a player (one row per user). The game's existing
/// save shapes (ArsenalSave / MarineSave / loadout) are stored verbatim as JSONB;
/// astro + bestLevel are hot scalars. Device settings stay on the device.
model PlayerProgress {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  arsenal       Json?
  marine        Json?
  loadout       Json?
  lifetimeStats Json?
  astro         Int      @default(0)
  bestLevel     Int      @default(0)
  updatedAt     DateTime @updatedAt
}

/// Single-use, hashed token for email verification + password reset.
model VerificationToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // 'verify' | 'reset'
  tokenHash String   @unique // sha256 of the raw token (raw is emailed, never stored)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}
